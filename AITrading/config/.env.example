OPENAI_BASE_URL="https://api.moonshot.cn/v1"
OPENAI_API_KEY=api_key

#OPENAI_MODEL="kimi-k2.6"
#OPENAI_TOP_P=0.95
#OPENAI_TEMPERATURE=1

OPENAI_MODEL="moonshot-v1-32k"
OPENAI_TEMPERATURE=0

# Gemini API key
# Used for: text to text
GEMINI_API_KEY=api_key

WEB_SEARCH_PROVIDER=eastmoney_public

# =========================
# Eastmoney Public Report API
# =========================
# 备用：当 WEB_SEARCH_PROVIDER=eastmoney_public 时使用
EASTMONEY_REPORT_BASE_URL=https://reportapi.eastmoney.com


# =========================
# Fallback Search Provider
# =========================
# 备用：当 WEB_SEARCH_PROVIDER=tavily 时使用
TAVILY_API_KEY=api_key
